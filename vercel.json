{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.mariamadeira.com" }],
      "destination": "https://mariamadeira.com/:path*",
      "permanent": true
    },
    {
      "source": "/results",
      "destination": "/case-studies",
      "permanent": true
    },
    {
      "source": "/case-study-seo-aeo",
      "destination": "/case-study-seo",
      "statusCode": 301
    }
  ]
}
